---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EXAMS } from '../data/exams';
import IdentityHeader from '../components/IdentityHeader';
import HomeWidgets from '../components/HomeWidgets';
import DailyCheck from '../components/DailyCheck';
import ThemeToggle from '../components/ThemeToggle';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const exams = Object.values(EXAMS);
---
<BaseLayout title="FINRA Exam Practice" description="Free practice questions for all major FINRA securities exams — SIE, Series 6, 7, 63, 65, 66">
  <main class="max-w-lg mx-auto px-4 py-8">

    <DailyCheck client:load />
    <div class="flex items-center justify-end mb-2">
      <ThemeToggle client:load />
    </div>
    <IdentityHeader client:load base={base} />
    <HomeWidgets client:load base={base} />

    {/* Header */}
    <header class="mb-10">
      <p class="text-xs uppercase tracking-[0.15em] text-[#8F5A39] font-medium mb-2">Securities licensing</p>
      <h1 style="font-family: var(--font-display);" class="text-4xl leading-tight text-black mb-3">
        FINRA exam<br/>practice
      </h1>
      <p class="text-sm text-[#6b6560]">Free practice questions for all major FINRA securities exams</p>
    </header>

    {/* Mock exam CTA */}
    <a
      href={`${base}exam`}
      class="group block w-full border border-black hover:bg-black transition-colors rounded-sm p-5 mb-6 no-underline"
    >
      <div class="flex items-center justify-between">
        <div>
          <div style="font-family: var(--font-display);" class="text-lg text-black group-hover:text-white transition-colors">
            Mock exam
          </div>
          <div class="text-xs text-[#6b6560] group-hover:text-white/70 transition-colors mt-0.5">
            Full-length timed simulation with near-miss analysis
          </div>
        </div>
        <div class="text-[#8F5A39] group-hover:text-white transition-colors text-lg">→</div>
      </div>
    </a>

    {/* Exam list */}
    <div class="space-y-px border border-[#E5E0D8] rounded-sm overflow-hidden">
      {exams.map((exam, i) => (
        <a
          href={`${base}${exam.slug}`}
          class="group block bg-white hover:bg-[#F4EFE7] transition-colors duration-150 no-underline"
        >
          <div class="flex items-center gap-4 px-5 py-4 border-b border-[#E5E0D8] last:border-b-0">
            {/* Exam label */}
            <div
              class="w-10 h-10 rounded-sm flex items-center justify-center shrink-0"
              style={`background-color: ${exam.iconBg};`}
            >
              <span class="text-white text-xs font-semibold tracking-wide leading-none text-center px-1">
                {exam.name.replace('Series ', 'S').replace('SIE', 'SIE')}
              </span>
            </div>

            {/* Content */}
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline justify-between gap-2">
                <span style="font-family: var(--font-display);" class="text-base text-black">{exam.name}</span>
                <span class={`text-xs font-medium px-2 py-0.5 rounded-sm shrink-0 ${exam.badgeClass}`}>
                  {exam.scoredQuestions}Q · {exam.minutes}min
                </span>
              </div>
              <p class="text-xs text-[#6b6560] mt-0.5 truncate">{exam.description}</p>
            </div>

            {/* Arrow */}
            <div class="text-[#8F5A39] text-sm shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">→</div>
          </div>
        </a>
      ))}
    </div>

    {/* Scandal Walkthroughs */}
    <section class="mt-10">
      <p class="text-xs uppercase tracking-[0.15em] text-[#6b6560] font-medium mb-3">Scandal walkthroughs</p>
      <div class="space-y-3">
        <a
          href={`${base}walkthroughs/madoff`}
          class="group block bg-black hover:bg-[#1a1a1a] rounded-sm p-5 no-underline transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 mb-1.5 font-medium">Investigation</p>
              <h3 style="font-family: var(--font-display);" class="text-lg text-white leading-snug mb-1">
                The Madoff Fraud
              </h3>
              <p class="text-xs text-white/50 leading-relaxed">
                How a $65 billion Ponzi scheme evaded regulators for decades
              </p>
              <div class="flex items-center gap-3 mt-3 text-xs text-white/30">
                <span>8 chapters</span>
                <span>|</span>
                <span>~15 min</span>
              </div>
            </div>
            <div class="text-white/40 group-hover:text-white transition-colors text-lg mt-1 shrink-0">&rarr;</div>
          </div>
        </a>
        <a
          href={`${base}walkthroughs/enron`}
          class="group block bg-black hover:bg-[#1a1a1a] rounded-sm p-5 no-underline transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 mb-1.5 font-medium">Investigation</p>
              <h3 style="font-family: var(--font-display);" class="text-lg text-white leading-snug mb-1">
                The Enron Collapse
              </h3>
              <p class="text-xs text-white/50 leading-relaxed">
                How accounting fraud and conflicts of interest destroyed the seventh-largest US company
              </p>
              <div class="flex items-center gap-3 mt-3 text-xs text-white/30">
                <span>8 chapters</span>
                <span>|</span>
                <span>~15 min</span>
              </div>
            </div>
            <div class="text-white/40 group-hover:text-white transition-colors text-lg mt-1 shrink-0">&rarr;</div>
          </div>
        </a>
        <a
          href={`${base}walkthroughs/gamestop`}
          class="group block bg-black hover:bg-[#1a1a1a] rounded-sm p-5 no-underline transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 mb-1.5 font-medium">Investigation</p>
              <h3 style="font-family: var(--font-display);" class="text-lg text-white leading-snug mb-1">
                The GameStop Saga
              </h3>
              <p class="text-xs text-white/50 leading-relaxed">
                How Reddit traders broke Wall Street and exposed the plumbing of modern markets
              </p>
              <div class="flex items-center gap-3 mt-3 text-xs text-white/30">
                <span>8 chapters</span>
                <span>|</span>
                <span>~15 min</span>
              </div>
            </div>
            <div class="text-white/40 group-hover:text-white transition-colors text-lg mt-1 shrink-0">&rarr;</div>
          </div>
        </a>
        <a
          href={`${base}walkthroughs/financial-crisis-2008`}
          class="group block bg-black hover:bg-[#1a1a1a] rounded-sm p-5 no-underline transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 mb-1.5 font-medium">Investigation</p>
              <h3 style="font-family: var(--font-display);" class="text-lg text-white leading-snug mb-1">
                The 2008 Financial Crisis
              </h3>
              <p class="text-xs text-white/50 leading-relaxed">
                How deregulation, toxic mortgages, and unchecked leverage collapsed the global financial system
              </p>
              <div class="flex items-center gap-3 mt-3 text-xs text-white/30">
                <span>8 chapters</span>
                <span>|</span>
                <span>~15 min</span>
              </div>
            </div>
            <div class="text-white/40 group-hover:text-white transition-colors text-lg mt-1 shrink-0">&rarr;</div>
          </div>
        </a>
        <a
          href={`${base}walkthroughs/ftx`}
          class="group block bg-black hover:bg-[#1a1a1a] rounded-sm p-5 no-underline transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 mb-1.5 font-medium">Investigation</p>
              <h3 style="font-family: var(--font-display);" class="text-lg text-white leading-snug mb-1">
                The FTX Crypto Fraud
              </h3>
              <p class="text-xs text-white/50 leading-relaxed">
                How an $8 billion customer fund theft hid behind effective altruism and a crypto empire
              </p>
              <div class="flex items-center gap-3 mt-3 text-xs text-white/30">
                <span>8 chapters</span>
                <span>|</span>
                <span>~15 min</span>
              </div>
            </div>
            <div class="text-white/40 group-hover:text-white transition-colors text-lg mt-1 shrink-0">&rarr;</div>
          </div>
        </a>
      </div>
    </section>

    {/* Footer */}
    <footer class="mt-10 pt-6 border-t border-[#E5E0D8]">
      <p class="text-xs text-[#6b6560] leading-relaxed mb-4">
        All practice questions are original content based on FINRA public content outlines.
        This site is not affiliated with or endorsed by FINRA.
      </p>
      <p class="text-xs text-[#6b6560] leading-relaxed italic">
        Made for my wife{' '}
        <a
          href="https://www.linkedin.com/in/grishmashanbhag/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#8F5A39] hover:text-black underline-offset-2 hover:underline transition-colors"
        >
          Grishma Shanbhag
        </a>
        {' '}— Senior ED, JPM Prime Brokerage SF.
      </p>
    </footer>

  </main>
</BaseLayout>
