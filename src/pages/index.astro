---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EXAMS } from '../data/exams';

const base = import.meta.env.BASE_URL;
const exams = Object.values(EXAMS);
---
<BaseLayout title="FINRA Exam Practice" description="Free practice for all major FINRA securities exams — SIE, Series 6, 7, 63, 65, 66">
  <main class="max-w-lg mx-auto px-4 py-6">

    {/* Hero */}
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">FINRA Exam Practice</h1>
      <p class="text-gray-500 text-sm">Free practice questions for all major FINRA exams</p>
    </div>

    {/* Exam cards */}
    <div class="space-y-3">
      {exams.map((exam) => (
        <a
          href={`${base}${exam.slug}`}
          class="block bg-white border border-gray-200 rounded-2xl p-5 hover:shadow-md hover:border-gray-300 transition-all active:scale-[0.98] no-underline"
        >
          <div class="flex items-center gap-4">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${exam.colorClass} flex items-center justify-center text-2xl shrink-0`}>
              {exam.icon}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-0.5">
                <span class="text-base font-bold text-gray-900">{exam.name}</span>
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${exam.badgeClass}`}>
                  {exam.scoredQuestions}Q · {exam.minutes}min
                </span>
              </div>
              <p class="text-sm text-gray-500 leading-snug truncate">{exam.description}</p>
            </div>
            <div class="text-gray-300 text-xl shrink-0">›</div>
          </div>
        </a>
      ))}
    </div>

    {/* Footer note */}
    <p class="text-center text-xs text-gray-400 mt-8 leading-relaxed">
      All practice questions are original content based on FINRA public content outlines.
    </p>

  </main>
</BaseLayout>
