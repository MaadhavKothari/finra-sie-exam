---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { EXAMS } from '../../data/exams';
import type { ExamId } from '../../data/exams';

export function getStaticPaths() {
  return [
    { params: { exam: 'sie' } },
    { params: { exam: 'series-6' } },
    { params: { exam: 'series-7' } },
    { params: { exam: 'series-63' } },
    { params: { exam: 'series-65' } },
    { params: { exam: 'series-66' } },
    { params: { exam: 'series-3' } },
    { params: { exam: 'series-24' } },
    { params: { exam: 'series-79' } },
  ];
}

const { exam } = Astro.params;
const examId = exam as ExamId;
const examData = EXAMS[examId];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Count questions per section
const sectionCounts: Record<string, number> = {};

if (exam === 'sie') {
  const [cm, pr, ta, rf] = await Promise.all([
    getCollection('capital-markets'),
    getCollection('products-risks'),
    getCollection('trading-accounts'),
    getCollection('regulatory-framework'),
  ]);
  sectionCounts['capital-markets'] = cm.length;
  sectionCounts['products-risks'] = pr.length;
  sectionCounts['trading-accounts'] = ta.length;
  sectionCounts['regulatory-framework'] = rf.length;
} else if (exam === 'series-6') {
  for (const q of await getCollection('series-6')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-7') {
  for (const q of await getCollection('series-7')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-63') {
  for (const q of await getCollection('series-63')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-65') {
  for (const q of await getCollection('series-65')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-66') {
  for (const q of await getCollection('series-66')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-3') {
  for (const q of await getCollection('series-3')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-24') {
  for (const q of await getCollection('series-24')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
} else if (exam === 'series-79') {
  for (const q of await getCollection('series-79')) sectionCounts[q.data.section] = (sectionCounts[q.data.section] ?? 0) + 1;
}

const totalQuestions = Object.values(sectionCounts).reduce((a, b) => a + b, 0);
const isLight = examData.headerClass.includes('text-black');
---

<BaseLayout title={examData.name} description={examData.description}>
  <main class="max-w-lg mx-auto px-4 py-6">

    {/* Back */}
    <a href={base} class="text-xs uppercase tracking-[0.12em] text-[#8F5A39] hover:text-black transition-colors mb-6 inline-block font-medium">
      ← All exams
    </a>

    {/* Hero card */}
    <div class={`${examData.headerClass} rounded-sm p-6 mb-6`}>
      <div class="mb-4">
        <p class={`text-xs uppercase tracking-[0.15em] font-medium mb-1 ${isLight ? 'text-[#8F5A39]' : 'text-white/60'}`}>
          {examData.fullName}
        </p>
        <h1 style="font-family: var(--font-display);" class="text-3xl leading-tight mb-2">
          {examData.name}
        </h1>
        <p class={`text-sm leading-relaxed ${isLight ? 'text-[#6b6560]' : 'text-white/80'}`}>
          {examData.description}
        </p>
      </div>
      <div class={`flex gap-3 text-xs flex-wrap ${isLight ? 'text-[#6b6560]' : 'text-white/70'}`}>
        <span class={`px-2.5 py-1 rounded-sm border ${isLight ? 'border-[#E5E0D8] bg-white/60' : 'border-white/20 bg-white/10'}`}>
          {examData.scoredQuestions} questions
        </span>
        <span class={`px-2.5 py-1 rounded-sm border ${isLight ? 'border-[#E5E0D8] bg-white/60' : 'border-white/20 bg-white/10'}`}>
          {examData.minutes} min
        </span>
        <span class={`px-2.5 py-1 rounded-sm border ${isLight ? 'border-[#E5E0D8] bg-white/60' : 'border-white/20 bg-white/10'}`}>
          {examData.passingScore}% to pass
        </span>
      </div>
    </div>

    {/* Quick practice CTAs — only when content exists */}
    {totalQuestions > 0 ? (
      <div class="flex gap-3 mb-6">
        <a
          href={`${base}${exam}/drill/all`}
          class="group flex-1 block border border-black hover:bg-black transition-colors rounded-sm p-5 no-underline"
        >
          <div class="flex items-center justify-between">
            <div>
              <div style="font-family: var(--font-display);" class="text-lg text-black group-hover:text-white transition-colors">
                Drill
              </div>
              <div class="text-xs text-[#6b6560] group-hover:text-white/70 transition-colors mt-0.5">
                {totalQuestions}Q — all sections
              </div>
            </div>
            <div class="text-[#8F5A39] group-hover:text-white transition-colors text-lg">→</div>
          </div>
        </a>
        <a
          href={`${base}${exam}/learn/all`}
          class="group flex-1 block border border-[#8F5A39] hover:bg-[#8F5A39] transition-colors rounded-sm p-5 no-underline"
        >
          <div class="flex items-center justify-between">
            <div>
              <div style="font-family: var(--font-display);" class="text-lg text-[#8F5A39] group-hover:text-white transition-colors">
                Learn
              </div>
              <div class="text-xs text-[#6b6560] group-hover:text-white/70 transition-colors mt-0.5">
                3-phase mastery
              </div>
            </div>
            <div class="text-[#8F5A39] group-hover:text-white transition-colors text-lg">→</div>
          </div>
        </a>
      </div>
    ) : (
      <div class="w-full border border-[#E5E0D8] bg-[#F4EFE7] rounded-sm p-5 mb-6">
        <div style="font-family: var(--font-display);" class="text-lg text-black mb-1">
          Questions coming soon
        </div>
        <div class="text-xs text-[#6b6560] leading-relaxed">
          We're still writing the question bank for {examData.name}. Check back shortly — or practice other exams in the meantime.
        </div>
      </div>
    )}

    {/* Sections */}
    <h2 class="text-xs uppercase tracking-[0.15em] text-[#6b6560] font-medium mb-3">Practice by section</h2>
    <div class="border border-[#E5E0D8] rounded-sm overflow-hidden mb-8">
      {examData.sections.map((section, i) => {
        const count = sectionCounts[section.id] ?? 0;
        const weight = Math.round(section.weight * 100);
        const isLast = i === examData.sections.length - 1;
        const hasContent = count > 0;
        return (
          <div
            class={`bg-white ${!hasContent ? 'opacity-60' : ''} ${!isLast ? 'border-b border-[#E5E0D8]' : ''}`}
          >
            <div class="px-5 py-4">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="text-sm text-black leading-snug">{section.name}</h3>
                <span class={`text-xs shrink-0 px-2 py-0.5 rounded-sm font-medium mt-0.5 ${examData.badgeClass}`}>
                  {weight}%
                </span>
              </div>
              <div class="flex items-center gap-3">
                <div class="flex-1 bg-[#E5E0D8] rounded-full h-1">
                  <div
                    class={`${examData.progressClass} h-1 rounded-full transition-all`}
                    style={`width: ${weight}%`}
                  />
                </div>
                <span class="text-xs text-[#6b6560] whitespace-nowrap shrink-0">
                  {count > 0 ? `${count}Q` : 'Coming soon'}
                </span>
              </div>
              {hasContent && (
                <div class="flex gap-2 mt-2.5">
                  <a
                    href={`${base}${exam}/drill/${section.id}`}
                    class="text-xs px-3 py-1.5 rounded-sm border border-[#E5E0D8] text-[#6b6560] hover:border-black hover:text-black transition-colors no-underline font-medium"
                  >
                    Drill
                  </a>
                  <a
                    href={`${base}${exam}/learn/${section.id}`}
                    class="text-xs px-3 py-1.5 rounded-sm border border-[#8F5A39] text-[#8F5A39] hover:bg-[#8F5A39] hover:text-white transition-colors no-underline font-medium"
                  >
                    Learn
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    {/* Exam stats */}
    <div class="bg-[#F4EFE7] rounded-sm p-4 text-center">
      <p class="text-xs text-[#6b6560] leading-relaxed">
        {examData.scoredQuestions} scored questions &middot; {examData.minutes} min &middot; {examData.passingScore}% to pass
      </p>
    </div>

  </main>
</BaseLayout>
